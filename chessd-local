#!/bin/sh
#
# Wrapper for starting the FatICS server on this host.
# The stock ./chessd script fails because the bundled venv was created
# on another machine (stale /home/aaron/... paths, broken python, no
# system Python 2.7). This uses the Python 2.7.18 built in ~/py27
# (with the venv's site-packages linked in) instead.
#
# Usage: ./chessd-local (start|stop|run|restart|log)

cd `dirname $0`

PYTHONHOME=/home/mattjb/py27
PYTHON=$PYTHONHOME/bin/python2.7
TWISTD="$PYTHON venv/bin/twistd"
export PYTHONHOME
export LD_LIBRARY_PATH=/usr/local/lib

PIDFILE=chessd.pid
LOGFILE=chessd.log

case "$1" in
  start)
    echo "Starting chessd...."
    $TWISTD --logfile $LOGFILE --pidfile $PIDFILE -r epoll -oy src/chessd.tac
    ;;
  run)
    echo "Running chessd in the foreground...."
    $TWISTD --pidfile $PIDFILE -r epoll -noy src/chessd.tac
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  log)
    echo "Showing chessd log..."
    tail -100 $LOGFILE
    ;;
  stop)
    if [ -f $PIDFILE ]; then
      echo "Stopping chessd...."
      kill `cat $PIDFILE`
      rm -f $PIDFILE
    else
      echo "Chessd does not appear to be running...."
    fi
    ;;
  *)
    echo "Usage: $0 (start|stop|run|restart|log)"
    ;;
esac
